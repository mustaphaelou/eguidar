# Copy to .env and adjust. docker-compose.yml reads POSTGRES_* and MEILI_MASTER_KEY;
# the app reads everything else.
#
# Les valeurs faibles de ce fichier sont des exemples de développement, jamais des
# identifiants de production. Chaque variable de production porte son propre
# avertissement : ne jamais déployer ce fichier tel quel.

# --- Postgres ---
POSTGRES_USER=eguidar
# Générez votre propre mot de passe : ne jamais réutiliser la valeur d'exemple en production.
POSTGRES_PASSWORD=eguidar
POSTGRES_DB=eguidar
# Cette URL embarque le mot de passe d'exemple : remplacez-la par votre propre valeur, jamais celle-ci en production.
DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar
# Cette URL de test embarque le même mot de passe d'exemple : remplacez-la par votre propre valeur, jamais celle-ci en production.
TEST_DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar_test
TEST_DB_NAME=eguidar_test

# --- Redis (Next cache backend) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
# Générez votre propre clé maître : ne jamais réutiliser la valeur d'exemple en production.
MEILI_MASTER_KEY=meili-dev-master-key

# --- Better Auth ---
# Générez votre propre secret avec `npx auth secret` : ne jamais réutiliser la valeur d'exemple en production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
# Générez votre propre secret client Google : ne jamais réutiliser la valeur d'exemple en production.
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
# Générez votre propre secret client Facebook : ne jamais réutiliser la valeur d'exemple en production.
FACEBOOK_CLIENT_SECRET=

# --- Cloudflare Turnstile ---
# Générez votre propre clé secrète dans la console Cloudflare : ne jamais réutiliser la valeur d'exemple en production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Resend ---
# Générez votre propre clé API : ne jamais réutiliser la valeur d'exemple en production.
RESEND_API_KEY=
# Remplacez l'expéditeur d'exemple (domaine de test Resend) par votre propre domaine vérifié : ne jamais l'utiliser en production.
EMAIL_FROM=Eguidar <onboarding@resend.dev>

# --- Cloudflare R2 (images produits) ---
R2_ACCOUNT_ID=
# Générez votre propre clé d'accès : ne jamais réutiliser la valeur d'exemple en production.
R2_ACCESS_KEY_ID=
# Générez votre propre clé secrète : ne jamais réutiliser la valeur d'exemple en production.
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eguidar
R2_PUBLIC_URL=https://pub.example.com
# RETENTION_BROUILLON_IMAGE_PRODUIT_H=24

# --- Seed / admin account ---
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@eguidar.com
# Générez votre propre mot de passe administrateur : ne jamais réutiliser la valeur d'exemple en production.
ADMIN_PASSWORD=change-me-admin-password
