# Copy to .env and adjust. docker-compose.yml reads POSTGRES_* and MEILI_MASTER_KEY;
# the app reads everything else.
#
# Les valeurs faibles de ce fichier sont des exemples de développement, jamais des
# identifiants de production. Chaque variable de production porte son propre
# avertissement : ne jamais déployer ce fichier tel quel.

# --- Postgres ---
POSTGRES_USER=eguidar
# Générez votre propre mot de passe : ne jamais réutiliser la valeur d'exemple en production.
POSTGRES_PASSWORD=eguidar
POSTGRES_DB=eguidar
# Cette URL embarque le mot de passe d'exemple : remplacez-la par votre propre valeur, jamais celle-ci en production.
DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar
# Cette URL de test embarque le même mot de passe d'exemple : remplacez-la par votre propre valeur, jamais celle-ci en production.
TEST_DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar_test
TEST_DB_NAME=eguidar_test
# Crédential de construction : la base en lecture seule que `next build` lit pour prérendre le catalogue.
# Docker la reçoit en secret BuildKit (docker-compose.yml) ; elle n'entre dans aucune couche ni build arg.
# Cette URL d'exemple vise la base de test publiée par `docker compose up -d`, que le build local
# `docker build --network host` du README joint sur le loopback. Remplacez la crédential, jamais par
# la valeur d'exemple en production. Pour un `docker compose build` local, posez aussi
# POSTGRES_HOST_BIND=172.17.0.1 et l'hôte `host.docker.internal` : le build ne partage pas le
# loopback. Sous Coolify, le build reste sur le bridge et vise `host.docker.internal` (voir README).
DATABASE_URL_BUILD=postgresql://eguidar:eguidar@127.0.0.1:5433/eguidar_test
# Adresse sur laquelle `docker compose` publie Postgres. Loopback par défaut : `localhost:5433`
# sert le développement et les tests. Sous Coolify, le build joint la base par le gateway du
# bridge : posez POSTGRES_HOST_BIND=172.17.0.1 (l’IP de `docker0`, `ip -4 addr show docker0`)
# dans les variables d’environnement de l’application, buildtime comprises, et
# `DATABASE_URL_BUILD` en `host.docker.internal`.
POSTGRES_HOST_BIND=127.0.0.1

# --- Redis (Next cache backend) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
# Générez votre propre clé maître : ne jamais réutiliser la valeur d'exemple en production.
MEILI_MASTER_KEY=meili-dev-master-key

# --- Better Auth ---
# Générez votre propre secret avec `npx auth secret` : ne jamais réutiliser la valeur d'exemple en production.
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
# Générez votre propre secret client Google : ne jamais réutiliser la valeur d'exemple en production.
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
# Générez votre propre secret client Facebook : ne jamais réutiliser la valeur d'exemple en production.
FACEBOOK_CLIENT_SECRET=

# --- Cloudflare Turnstile ---
# Générez votre propre clé secrète dans la console Cloudflare : ne jamais réutiliser la valeur d'exemple en production.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Resend ---
# Générez votre propre clé API : ne jamais réutiliser la valeur d'exemple en production.
RESEND_API_KEY=
# Remplacez l'expéditeur d'exemple (domaine de test Resend) par votre propre domaine vérifié : ne jamais l'utiliser en production.
EMAIL_FROM=Eguidar <onboarding@resend.dev>

# --- Cloudflare R2 (images produits) ---
R2_ACCOUNT_ID=
# Générez votre propre clé d'accès : ne jamais réutiliser la valeur d'exemple en production.
R2_ACCESS_KEY_ID=
# Générez votre propre clé secrète : ne jamais réutiliser la valeur d'exemple en production.
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eguidar
R2_PUBLIC_URL=https://pub.example.com
# RETENTION_BROUILLON_IMAGE_PRODUIT_H=24

# --- Cloudflare (purge du cache de l'edge) ---
# Sans ces deux variables, la purge de l'edge est un no-op journalisé et les
# écritures d'administration restent possibles. Au déploiement, le service
# `purge-edge` les lit et vide toute la zone avant que l'application ne démarre.
CLOUDFLARE_ZONE_ID=
# Le jeton doit porter « Cache Purge » sur la zone (et « Workers R2 Storage:
# Edit » s'il sert aussi à la règle de cycle de vie des Brouillons).
CLOUDFLARE_API_TOKEN=
# La purge au déploiement est active dès que la zone et le jeton sont fournis.
# Pour la désactiver sans toucher au code (déploiement qui doit passer malgré
# Cloudflare), décommentez :
# PURGE_EDGE=off

# --- Seed / admin account ---
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@eguidar.com
# Générez votre propre mot de passe administrateur : ne jamais réutiliser la valeur d'exemple en production.
ADMIN_PASSWORD=change-me-admin-password
