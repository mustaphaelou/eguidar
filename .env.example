# Copy to .env and adjust. docker-compose.yml reads POSTGRES_* and MEILI_MASTER_KEY;
# the app reads everything else.

# --- Postgres ---
POSTGRES_USER=eguidar
POSTGRES_PASSWORD=eguidar
POSTGRES_DB=eguidar
DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar
TEST_DATABASE_URL=postgresql://eguidar:eguidar@localhost:5433/eguidar_test
TEST_DB_NAME=eguidar_test

# --- Redis (Next cache backend) ---
REDIS_URL=redis://localhost:6379

# --- Meilisearch ---
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=meili-dev-master-key

# --- Better Auth ---
# Generate with: npx auth secret
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=

# --- Cloudflare Turnstile ---
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# --- Resend ---
RESEND_API_KEY=
EMAIL_FROM=Eguidar <onboarding@resend.dev>

# --- Cloudflare R2 (images produits) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=eguidar
R2_PUBLIC_URL=https://pub.example.com

# --- Seed / admin account ---
ADMIN_NAME=Administrateur
ADMIN_EMAIL=admin@eguidar.com
ADMIN_PASSWORD=change-me-admin-password
