#!/usr/bin/env bash

set -euo pipefail

cd -- "$(git rev-parse --show-toplevel)"

if ! COUVERTS="$(node --import tsx scripts/format.ts --indexes)"; then
  exit 1
fi

if [ -z "$COUVERTS" ]; then
  exit 0
fi

mapfile -t CHEMINS < <(printf '%s' "$COUVERTS")

node --import tsx scripts/format.ts "${CHEMINS[@]}"