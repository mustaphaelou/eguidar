generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- Better Auth (core tables, generated from the auth config's schema) ---

model user {
  id              String   @id
  name            String
  email           String   @unique
  emailVerified   Boolean  @default(false)
  image           String?
  phone           String?
  shippingAddress String?
  shippingCityId  String?
  role            String   @default("user")
  createdAt       DateTime @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  shippingCity           DeliveryCity?           @relation(fields: [shippingCityId], references: [id])
  accounts               account[]
  sessions               session[]
  cartItems              CartItem[]
  orders                 Order[]
  payments               Payment[]
  refunds                Refund[]
  statusChanges          OrderStatusChange[]
  brouillonsImageProduit BrouillonImageProduit[]
  lotsImport             LotImport[]
}

model session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  user user @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Une identité de fournisseur (Google, Facebook) ne désigne qu'un seul
  // Compte client, même si deux connexions arrivent en même temps.
  @@unique([providerId, accountId])
  @@index([userId])
}

model verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@index([identifier])
}

// --- Commerce ---

model Category {
  id        String     @id @default(cuid())
  name      String
  slug      String     @unique
  image     String?
  parentId  String?
  position  Int        @default(0)
  parent    Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @db.Timestamptz(3)

  @@index([parentId, position])
}

model Product {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  description            String
  brand                  String
  specs                  Json
  price                  Int
  images                 Json
  isFeatured             Boolean                 @default(false)
  featuredOrder          Int                     @default(0)
  freeShipping           Boolean                 @default(false)
  categoryId             String?
  category               Category?               @relation(fields: [categoryId], references: [id])
  variants               ProductVariant[]
  articlesBlog           ArticleBlogProduit[]
  brouillonsImageProduit BrouillonImageProduit[]
  createdAt              DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)

  @@index([categoryId])
  @@index([isFeatured, featuredOrder])
}

model ProductVariant {
  id         String     @id @default(cuid())
  name       String
  sku        String     @unique
  priceDelta Int        @default(0)
  stock      Int        @default(0)
  productId  String
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems  CartItem[]
  createdAt  DateTime   @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @db.Timestamptz(3)

  @@index([productId])
}

model BrouillonImageProduit {
  id                String   @id
  storageKey        String   @unique
  mimeType          String
  byteSize          Int
  ownerId           String
  tentativeId       String?
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  expiresAt         DateTime @db.Timestamptz(3)
  state             String   @default("vivant")
  promotedPublicUrl String?
  productId         String?

  owner   user     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([tentativeId])
  @@index([state, expiresAt])
  @@index([productId])
}

model ImageProduit {
  id        String   @id @default(cuid())
  publicUrl String   @unique
  mimeType  String
  byteSize  Int
  width     Int
  height    Int
  alt       String?
  createdBy String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
}

model CartItem {
  id        String         @id @default(cuid())
  userId    String
  user      user           @relation(fields: [userId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int            @default(1)
  createdAt DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @db.Timestamptz(3)

  @@unique([userId, variantId])
  @@index([userId])
}

enum OrderStatus {
  pending
  confirmed
  shipped
  delivered
  cancelled
  returned
}

enum PaymentMode {
  cash_on_delivery
}

model Order {
  id            String              @id @default(cuid())
  userId        String
  user          user                @relation(fields: [userId], references: [id])
  cityName      String
  address       String
  phone         String
  total         Int
  shippingFee   Int
  totalPayable  Int
  status        OrderStatus         @default(pending)
  items         OrderItem[]
  returns       Return[]
  deliveredAt   DateTime?           @db.Timestamptz(3)
  payments      Payment[]
  statusChanges OrderStatusChange[]
  createdAt     DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime            @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@index([status])
}

// Un Encaissement : l'argent reçu pour une Commande. La livraison en écrit
// exactement un, dans la transaction du passage à `delivered` (spec #1025).
model Payment {
  id           String      @id @default(cuid())
  orderId      String
  order        Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount       Int
  mode         PaymentMode @default(cash_on_delivery)
  collectedAt  DateTime    @db.Timestamptz(3)
  recordedById String?
  recordedBy   user?       @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  refunds      Refund[]
  createdAt    DateTime    @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

// Un Changement de statut : chaque Transition de statut écrite avec son acteur
// et son instant (spec #1025).
model OrderStatusChange {
  id         String      @id @default(cuid())
  orderId    String
  order      Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus OrderStatus
  toStatus   OrderStatus
  changedAt  DateTime    @db.Timestamptz(3)
  actorId    String?
  actor      user?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  reason     String?

  @@index([orderId, changedAt])
}

model OrderItem {
  id          String       @id @default(cuid())
  orderId     String
  order       Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId   String?
  productName String
  variantName String
  price       Int
  quantity    Int
  returnLines ReturnLine[]
  createdAt   DateTime     @default(now()) @db.Timestamptz(3)

  @@index([orderId])
}

enum ReturnStatus {
  requested
  received
  refused
}

enum ReturnReason {
  withdrawal
  non_conformity
  goodwill
  other
}

enum ReturnRefusalCode {
  out_of_window
  excluded_by_law
  not_received
  condition_mismatch
  other
}

enum ReturnLineCondition {
  resellable
  damaged
}

model Return {
  id          String             @id @default(cuid())
  orderId     String
  order       Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      ReturnStatus       @default(requested)
  reason      ReturnReason
  requestedAt DateTime           @db.Timestamptz(3)
  receivedAt  DateTime?          @db.Timestamptz(3)
  refusalCode ReturnRefusalCode?
  refusalNote String?
  lines       ReturnLine[]
  refunds     Refund[]
  createdAt   DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(3)

  @@index([orderId])
}

model ReturnLine {
  id               String               @id @default(cuid())
  returnId         String
  return           Return               @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItemId      String
  orderItem        OrderItem            @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  declaredQuantity Int
  receivedQuantity Int?
  condition        ReturnLineCondition?
  createdAt        DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime             @updatedAt @db.Timestamptz(3)

  @@unique([returnId, orderItemId])
  @@index([orderItemId])
}

enum RefundMode {
  cash
  transfer
}

model Refund {
  id             String     @id @default(cuid())
  paymentId      String
  payment        Payment    @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  returnId       String?
  return         Return?    @relation(fields: [returnId], references: [id], onDelete: SetNull)
  amount         Int
  mode           RefundMode
  refundedAt     DateTime   @db.Timestamptz(3)
  recordedById   String?
  recordedBy     user?      @relation(fields: [recordedById], references: [id], onDelete: SetNull)
  reason         String?
  idempotencyKey String     @unique
  createdAt      DateTime   @default(now()) @db.Timestamptz(3)

  @@index([paymentId])
  @@index([returnId])
}

model DeliveryCity {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  fee       Int
  users     user[]
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
}

model ShippingSettings {
  id                    String   @id @default("default")
  freeShippingThreshold Int
  updatedAt             DateTime @updatedAt @db.Timestamptz(3)
}

// --- Blog ---

enum StatutPublication {
  brouillon
  publie
  archive
}

model Theme {
  id        String        @id @default(cuid())
  slug      String        @unique
  nom       String        @unique
  articles  ArticleBlog[]
  createdAt DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt DateTime      @updatedAt @db.Timestamptz(3)
}

model ArticleBlog {
  id          String               @id @default(cuid())
  titre       String
  slug        String               @unique
  extrait     String
  chapo       String?
  couverture  String?
  contenu     String
  notes       String?
  themeId     String
  theme       Theme                @relation(fields: [themeId], references: [id])
  statut      StatutPublication    @default(brouillon)
  publishedAt DateTime?            @db.Timestamptz(3)
  createdAt   DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(3)
  produits    ArticleBlogProduit[]

  @@index([statut, publishedAt])
  @@index([themeId])
}

model ArticleBlogProduit {
  articleId String
  productId String
  ordre     Int         @default(0)
  article   ArticleBlog @relation(fields: [articleId], references: [id], onDelete: Cascade)
  produit   Product     @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([articleId, productId])
  @@index([productId])
}

// --- Automatisations durables (ADR-0044) ---

enum StatutAutomation {
  en_attente
  en_cours
  reussi
  echoue
  ignore
  mort
}

enum DeclencheurExecution {
  evenement
  planification
  manuel
}

model AutomationEvent {
  id          String           @id @default(cuid())
  type        String
  entityType  String
  entityId    String
  seq         Int
  attemptOf   Int
  payload     Json
  occurredAt  DateTime         @db.Timestamptz(3)
  expiresAt   DateTime         @db.Timestamptz(3)
  status      StatutAutomation @default(en_attente)
  attempts    Int              @default(0)
  lastError   String?
  availableAt DateTime         @default(now()) @db.Timestamptz(3)
  lockedUntil DateTime?        @db.Timestamptz(3)
  createdAt   DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @db.Timestamptz(3)

  runs AutomationRun[]

  @@unique([type, entityId, attemptOf])
  @@unique([entityType, entityId, seq])
  @@index([status, availableAt])
}

model AutomationRule {
  id           String   @id
  name         String
  enabled      Boolean  @default(true)
  trigger      String
  condition    Json
  action       String
  actionConfig Json?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  revisions AutomationRuleRevision[]
  runs      AutomationRun[]
}

model AutomationRuleRevision {
  id        String   @id @default(cuid())
  ruleId    String
  snapshot  Json
  author    String
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  rule AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId, createdAt])
}

model AutomationRun {
  id         String               @id @default(cuid())
  eventId    String?
  ruleId     String?
  action     String
  status     StatutAutomation     @default(en_cours)
  attempt    Int                  @default(1)
  lastError  String?
  durationMs Int?
  startedAt  DateTime             @default(now()) @db.Timestamptz(3)
  finishedAt DateTime?            @db.Timestamptz(3)
  trigger    DeclencheurExecution @default(evenement)
  createdAt  DateTime             @default(now()) @db.Timestamptz(3)

  event AutomationEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  rule  AutomationRule?  @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([eventId, ruleId, attempt])
  @@index([startedAt])
  @@index([status])
}

// --- Import de produits (spec #979) ---

enum StatutLotImport {
  brouillon
  verifie
  en_cours
  partiel
  termine
  echoue
}

enum StatutLigneImport {
  a_creer
  a_modifier
  inchangee
  refusee
  ecrite
  echouee
}

model LotImport {
  id                String          @id @default(cuid())
  auteurId          String?
  auteur            user?           @relation(fields: [auteurId], references: [id], onDelete: SetNull)
  empreinte         String
  taille            Int
  statut            StatutLotImport @default(brouillon)
  curseur           Int             @default(0)
  produitsCrees     Int             @default(0)
  produitsModifies  Int             @default(0)
  produitsInchanges Int             @default(0)
  produitsRefuses   Int             @default(0)
  ecrits            Int             @default(0)
  indexes           Int             @default(0)
  avertissements    String[]        @default([])
  motifEchec        String?
  createdAt         DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @db.Timestamptz(3)
  lignes            LigneImport[]

  @@index([createdAt])
  @@index([statut])
}

model LigneImport {
  id             String             @id @default(cuid())
  lotId          String
  lot            LotImport          @relation(fields: [lotId], references: [id], onDelete: Cascade)
  numero         Int
  slug           String
  sku            String
  cellules       Json
  enregistrement Json?
  codeRefus      String?
  avertissements String[]           @default([])
  diff           Json?
  statut         StatutLigneImport?
  motifEchec     String?
  createdAt      DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @db.Timestamptz(3)

  @@unique([lotId, numero])
  @@index([lotId, slug])
  @@index([lotId, statut])
}
